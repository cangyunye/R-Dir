{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "R-Dir",
  "mainBinaryName": "R-Dir",
  "version": "0.17.1",
  "identifier": "com.rfm.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "R-Dir",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f6f6f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "cangyunye",
    "shortDescription": "R-Dir 跨平台文件管理器",
    "longDescription": "基于 Tauri 2 + Rust + React 的跨平台文件管理器（macOS / Windows）",
    "copyright": "Copyright © 2026 cangyunye",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}